{
  "name": "vybe",
  "private": true,
  "description": "VYBE — mobile-first social discovery platform for real life, starting in Accra, Ghana.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@vybe/mobile",
    "web": "npm run dev --workspace=@vybe/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "test:db": "supabase test db"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
