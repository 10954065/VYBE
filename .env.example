# ============================================================
# VYBE — Environment Variables
# Copy this file to .env.local (web) / .env (mobile) and fill in.
# NEVER commit real values. Service-role / secret keys must only
# ever live on the server (apps/web), never in the mobile app.
# ============================================================

# --- App ---
NODE_ENV=development
APP_ENV=development            # development | staging | production

# --- Supabase (Database, Auth, Storage, Realtime) ---
# Public — safe to expose to the mobile client.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret — server-only (apps/web). Never ship to mobile or client bundles.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# --- Maps (abstracted — provider swappable, see packages/shared/map) ---
MAPS_PROVIDER=maplibre          # maplibre | mapbox | google
EXPO_PUBLIC_MAPS_API_KEY=

# --- Push Notifications ---
EXPO_PUBLIC_PROJECT_ID=
EAS_PROJECT_ID=

# --- Analytics ---
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Web/API deployment (Vercel) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin dashboard (apps/web /admin) ---
# Comma-separated emails allowed into /admin. Server-only — never prefix
# with NEXT_PUBLIC_. There's no admin role in the database; this list is
# the only thing that makes an account an admin.
ADMIN_EMAILS=

# --- Mobile -> API (apps/web) ---
# For endpoints the mobile app can't reach via RLS alone (e.g. account
# deletion, which needs the service role). Mobile sends its Supabase
# access token as a Bearer header; the API verifies it per-request.
EXPO_PUBLIC_API_URL=http://localhost:3000
